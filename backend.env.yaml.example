# Plantilla de variables de entorno para Cloud Run (backend).
# Copia este archivo a `backend.env.yaml`, rellena los valores reales y
# NO lo commitees (ya está en .gitignore). Todos los valores son STRING:
# los numéricos y booleanos van entre comillas.

ENVIRONMENT: production
DEBUG: "false"

# --- Base de datos (Neon) ---
# Pega la cadena de Neon. El backend normaliza el esquema a asyncpg y activa
# TLS automáticamente para hosts remotos.
DATABASE_URL: postgresql+asyncpg://USER:PASS@HOST.neon.tech/DB

# --- Auth (US-24) ---
# Genera uno fuerte:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY: CAMBIA_ESTO_POR_UN_SECRETO_FUERTE
ACCESS_TOKEN_EXPIRE_MINUTES: "480"

# --- GCP / agente IA (US-12). El project se fija en código a ulima-agent. ---
GCP_PROJECT_ID: ulima-agent
GCP_LOCATION: us-central1

# --- CORS / enlaces de correo ---
# Provisional: `make connect` los reemplaza con la URL real del frontend.
CORS_ORIGINS: '["http://localhost:3000"]'
FRONTEND_URL: http://localhost:3000

# --- Correo de reset de contraseña (US-25). App password de Gmail. ---
SMTP_HOST: smtp.gmail.com
SMTP_PORT: "587"
SMTP_USER: ""
SMTP_PASSWORD: ""
SMTP_FROM_NAME: SmartSched ULIMA
