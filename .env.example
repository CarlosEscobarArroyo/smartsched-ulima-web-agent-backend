# Entorno
ENVIRONMENT=local
DEBUG=true

# CORS (frontend Next.js)
CORS_ORIGINS=["http://localhost:3000"]

# Base de datos
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://smartsched:smartsched@localhost:5432/smartsched
# Neon (Postgres serverless gratis, en la nube). Usar el connection string DIRECTO
# (NO el "-pooler"), cambiar el esquema a "postgresql+asyncpg" y puedes dejar el
# "?sslmode=require..." — el backend lo limpia solo y activa SSL para hosts remotos:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME
# Cloud SQL via Auth Proxy (ejemplo):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/smartsched
# Cloud SQL desde Cloud Run (Unix socket):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@/smartsched?host=/cloudsql/PROJECT:REGION:INSTANCE

# GCP / Vertex AI
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
ULIMA_AGENT_ENDPOINT=

# Autenticación (US-24)
# Generar uno seguro: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=15

# Restablecimiento de contraseña (US-25) — email vía SMTP de Gmail.
# SMTP_USER es la cuenta de Gmail; SMTP_PASSWORD es una CONTRASEÑA DE APLICACIÓN
# (no la contraseña normal): https://myaccount.google.com/apppasswords (requiere 2FA).
# Si dejas SMTP_USER/SMTP_PASSWORD vacíos, el enlace de reset se imprime en el log (modo dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SmartSched ULIMA
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=60

